services:
  ersatztv:
    image: ghcr.io/ersatztv/legacy:latest
    container_name: ersatztv
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    # ErsatzTV does not use PUID/PGID environment variables
    user: ${PUID}:${PGID}
    networks:
      - proxy_net
    {% if 'ersatztv' in expose_ports_enabled_containers %}
    ports:
      - 8409:8409
    {% endif %}
    {% if enable_intel_gpu %}
    devices:
      - /dev/dri:/dev/dri
    {% if ersatztv_render_gid is defined %}
    group_add:
      - "{{ ersatztv_render_gid }}"
    {% endif %}
    {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/ersatztv/config:/config
      {% if not hmsdocker_transcode_tmpfs_enabled | default(false) %}
      - ${HMSD_APPS_PATH}/ersatztv/transcode:/transcode
      {% endif %}
      # media folder, used by local libraries and to play media from Plex/Jellyfin/Emby directly from disk
      - ${HMSD_MOUNT_PATH}:/data{{ ':ro' if 'ersatztv' in hmsdocker_readonly_media_containers | default([], true) }}
    {% if hmsdocker_transcode_tmpfs_enabled | default(false) %}
    tmpfs:
      - /transcode:size={{ hmsdocker_transcode_tmpfs_size | default('4g') }},mode=1777
    {% endif %}
    environment:
      - TZ=${TIMEZONE}
    {% if enable_nvidia_gpu %}
      - NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
      - NVIDIA_VISIBLE_DEVICES=all
    runtime: nvidia
    {% endif %}
    {% if 'ersatztv' in traefik_enabled_containers or 'ersatztv' in homepage_enabled_containers %}
    labels:
      {% if 'ersatztv' in traefik_enabled_containers %}
      - traefik.enable=true
      - traefik.http.services.ersatztv-${COMPOSE_PROJECT}.loadbalancer.server.port=8409
      - traefik.http.routers.ersatztv-${COMPOSE_PROJECT}.rule=Host(`{{ hms_docker_container_map['ersatztv']['proxy_host_rule'] | default('ersatztv') }}.${HMSD_DOMAIN}`)
      - traefik.http.routers.ersatztv-${COMPOSE_PROJECT}.middlewares={{ 'external' if 'ersatztv' in expose_public_enabled_containers else 'internal' }}-{{ 'secured' if traefik_security_hardening else 'ipallowlist' }}@file{{ ',authentik-proxy-${COMPOSE_PROJECT}-ersatztv-midware@docker' if 'ersatztv' in authentik_enabled_containers }}
      {% endif %}
      {% if 'ersatztv' in homepage_enabled_containers %}
      - homepage.group=Media
      - homepage.name=ErsatzTV
      - homepage.icon=ersatztv.png
      - homepage.href=http://{{ hms_docker_container_map['ersatztv']['proxy_host_rule'] | default('ersatztv') }}.${HMSD_DOMAIN}
      - homepage.description=Live TV Channels
        {% if 'ersatztv' in homepage_stats_enabled_containers %}
      - homepage.showStats=true
        {% endif %}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -fsS -o /dev/null http://127.0.0.1:8409/iptv/channels.m3u || exit 1
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
